# Supabase pooler, port 6543. The running API uses this.
# Copy the Transaction pooler string from the Supabase Connect dialog.
DATABASE_URL=postgresql://postgres.kwjcqhzczzlsugihybgi:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection, port 5432. Migrations use this. The host is IPv6-only.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.kwjcqhzczzlsugihybgi.supabase.co:5432/postgres

# 32 bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=

API_PUBLIC_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173

# OAuth client credentials. Connect stays disabled until the pair is set.
# Gmail, Google Drive, and Google Calendar share the Google pair.
# Add this redirect URL in each OAuth app: http://localhost:8787/v1/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Telegram and WhatsApp tokens are entered on the app page. They are not env vars.
# News reads a public RSS feed and needs no key.
